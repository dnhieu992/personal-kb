# MySQL connection.
# Option A (no Docker): reuse the host MySQL on 3306 with a separate database:
DATABASE_URL=mysql://pkb:pkbpass@127.0.0.1:3306/personal_kb
# Option B (Docker): docker-compose maps MySQL to host port 3307 (see docker-compose.yml):
# DATABASE_URL=mysql://pkb:pkbpass@127.0.0.1:3307/personal_kb

# AI runs through headless Claude Code on a claude.ai subscription (no API key).
# On a server: run `claude setup-token` and paste the token here. On a Mac with
# Claude Code logged in, leave it empty.
CLAUDE_CODE_OAUTH_TOKEN=

# Qdrant vector DB (required only for semantic search / chat)
QDRANT_URL=http://localhost:6333

# Backend HTTP port (4001 to avoid market-analysis on 3000/3001)
PORT=4001

# Allowed origin for CORS (the frontend)
FRONTEND_URL=http://localhost:4000

# Telegram push (personal-kb group) - real values live in /opt/personal-kb/backend.env
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Planner: time zone that decides "today" (default Asia/Ho_Chi_Minh). Task reminders
# are sent to the Telegram chat above.
# PLANNER_TZ=Asia/Ho_Chi_Minh
