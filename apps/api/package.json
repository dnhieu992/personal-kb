{
  "name": "@pkb/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "migrate:v1": "node dist/scripts/migrate-v1.js",
    "hash-password": "node dist/scripts/hash-password.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test:int": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/throttler": "^6.3.0",
    "@nestjs/typeorm": "^10.0.2",
    "@pkb/contracts": "workspace:*",
    "@qdrant/js-client-rest": "^1.20.0",
    "@xenova/transformers": "^2.17.2",
    "cookie-parser": "^1.4.7",
    "cron": "3.2.1",
    "mammoth": "^1.13.0",
    "mysql2": "^3.12.0",
    "pdf-parse": "^1.1.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.5",
    "dependency-cruiser": "^16.8.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
