# v2 API — copy to apps/api/.env (gitignored)
NODE_ENV=development
HOST=127.0.0.1
PORT=4201
APP_TZ=Asia/Ho_Chi_Minh
DATABASE_URL=mysql://pkb:pkbpass@127.0.0.1:3308/personal_kb_v2
# Run pending migrations on boot (dev convenience). Prod runs `node dist/migrate.js` as a deploy step.
MIGRATE_ON_BOOT=true

# Single-user auth. Generate with: pnpm --filter @pkb/api build && pnpm --filter @pkb/api hash-password 'your password'
AUTH_PASSWORD_HASH=
# >= 32 random chars: openssl rand -hex 32
SESSION_SECRET=
SESSION_DAYS=30
# true when the web app is served over HTTPS
COOKIE_SECURE=false

# Attachments: 'local' (dev, files under STORAGE_LOCAL_DIR, served via signed API URLs) or 'r2'
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# Public base URL the browser uses to reach the API through the web proxy (for local-driver upload URLs)
PUBLIC_API_BASE=/api
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# PRIVATE bucket for v2 (not the public v1 one). Needs a CORS rule allowing PUT from the web origin.
R2_BUCKET=

# One-shot v1 → v2 data migration (scripts/migrate-v1): the old database
V1_DATABASE_URL=mysql://pkb:pkbpass@127.0.0.1:3306/personal_kb

# --- Phase 3: semantic search (leave QDRANT_URL empty to switch it off) ---
# QDRANT_URL=http://127.0.0.1:6343
# QDRANT_API_KEY=
# QDRANT_COLLECTION=pkb_v2_notes
# MODEL_CACHE_DIR=/app/.cache/models

# --- English module ---
# COURSE_MODEL=claude-opus-5-5
# PIPER_BIN=/opt/piper/piper
# PIPER_MODEL=/opt/piper/voice.onnx
# TTS_CACHE_DIR=/app/.cache
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- AI (headless Claude Code). Token from `claude setup-token`; or mount ~/.claude ---
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Nightly DB backup → R2 (separate bucket, same R2 credentials). Off unless set. ---
# BACKUP_BUCKET=personal-kb-v2-backups
# BACKUP_KEEP=14
